# cp .env.example .env — і заповнити. .env у .gitignore; токени — лише зі сховища.
# B2_* і HC_BACKUP_URL існують лише на VPS (їх читають rclone/backup.sh, не застосунок).
# SMTP_* не заводити до тригера ADR-0011.
APP_ENV=dev
AUTH_MODE=dev
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=https://dev-s.zoshyt.in.ua
DB_URL=postgresql+asyncpg://zoshyt:zoshyt@localhost:5433/zoshyt
POSTGRES_PASSWORD=zoshyt
ADMIN_CHAT_ID=
HC_API_URL=
HC_BOT_URL=
HC_REMINDERS_URL=
